    "Restricted folder: DiskGarden couldn't read it. Grant Full Disk Access or run a Deep Scan (Admin)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد مقيّد: تعذّر على DiskGarden قراءته. امنح «الوصول الكامل إلى القرص» أو شغّل فحصًا عميقًا (مسؤول)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschützter Ordner: DiskGarden konnte ihn nicht lesen. Erteile Festplattenvollzugriff oder starte einen Tiefenscan (Admin)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta restringida: DiskGarden no pudo leerla. Concede acceso total al disco o ejecuta un análisis profundo (admin)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier restreint : DiskGarden n’a pas pu le lire. Accordez l’accès complet au disque ou lancez une analyse approfondie (admin)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella con restrizioni: DiskGarden non è riuscito a leggerla. Concedi l’accesso completo al disco o avvia una scansione approfondita (admin)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限されたフォルダ：DiskGarden は読み取れませんでした。フルディスクアクセスを許可するか、ディープスキャン（管理者）を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한된 폴더: DiskGarden이 읽을 수 없었습니다. 전체 디스크 접근 권한을 부여하거나 정밀 스캔(관리자)을 실행하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder z ograniczeniami: DiskGarden nie mógł go odczytać. Przyznaj pełny dostęp do dysku lub uruchom głębokie skanowanie (admin)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta restrita: o DiskGarden não conseguiu lê-la. Conceda Acesso Total ao Disco ou execute uma Análise Profunda (Admin)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta restrita: o DiskGarden não conseguiu lê-la. Conceda acesso total ao disco ou execute uma análise profunda (admin)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка с ограниченным доступом: DiskGarden не смог её прочитать. Предоставьте доступ ко всему диску или запустите глубокое сканирование (админ)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsad mapp: DiskGarden kunde inte läsa den. Ge hel skivåtkomst eller kör en djupskanning (admin)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısıtlı klasör: DiskGarden okuyamadı. Tam Disk Erişimi verin veya Derin Tarama (Yönetici) çalıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежена папка: DiskGarden не зміг її прочитати. Надайте повний доступ до диска або запустіть глибоке сканування (адмін)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục bị hạn chế: DiskGarden không đọc được. Hãy cấp quyền truy cập ổ đĩa đầy đủ hoặc chạy Quét sâu (Quản trị)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受限文件夹：DiskGarden 无法读取。请授予完全磁盘访问权限或运行深度扫描（管理员）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受限檔案夾：DiskGarden 無法讀取。請授與完整磁碟取用權限或執行深度掃描（管理者）。"
          }
        }
      }
    },
