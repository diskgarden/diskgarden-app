    "Facebook and LinkedIn only take the link; the text is copied for you to paste." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقبل Facebook وLinkedIn الرابط فقط؛ يتم نسخ النص لتلصقه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook und LinkedIn übernehmen nur den Link; der Text wird zum Einfügen kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook y LinkedIn solo admiten el enlace; el texto se copia para que lo pegues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook et LinkedIn n’acceptent que le lien ; le texte est copié pour que vous le colliez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook e LinkedIn accettano solo il link; il testo viene copiato perché tu lo incolli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FacebookとLinkedInはリンクのみ対応しています。テキストはコピーされるので貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook과 LinkedIn은 링크만 받습니다. 텍스트는 붙여넣을 수 있도록 복사됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook i LinkedIn przyjmują tylko link; tekst zostaje skopiowany do wklejenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Facebook e o LinkedIn aceitam só o link; o texto é copiado para você colar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Facebook e o LinkedIn aceitam apenas a ligação; o texto é copiado para o colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook и LinkedIn принимают только ссылку; текст скопирован, чтобы вы его вставили."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook och LinkedIn tar bara emot länken; texten kopieras så att du kan klistra in den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook ve LinkedIn yalnızca bağlantıyı alır; metin yapıştırmanız için kopyalanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook і LinkedIn приймають лише посилання; текст скопійовано, щоб ви його вставили."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook và LinkedIn chỉ nhận liên kết; văn bản đã được sao chép để bạn dán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook 和 LinkedIn 只接受链接；文字已拷贝，可直接粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook 和 LinkedIn 只接受連結；文字已拷貝，可直接貼上。"
          }
        }
      }
    },
