          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden ещё удаляет файлы. Если выйти сейчас, остальные файлы останутся на месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
