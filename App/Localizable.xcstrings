          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden показывает на красивой интерактивной карте, чем заполнен ваш Mac, и помогает навести порядок. Бесплатно для macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
