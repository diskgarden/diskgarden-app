    "DiskGarden %@ is ready. Restart to install it now, or it installs when you quit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden %@ جاهز. أعد التشغيل لتثبيته الآن، أو سيُثبَّت عند الإنهاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden %@ ist bereit. Starte neu, um es jetzt zu installieren, sonst wird es beim Beenden installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden %@ está listo. Reinicia para instalarlo ahora, o se instalará al salir."
