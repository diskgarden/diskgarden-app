    "If you quit now, DiskGarden will forget the files in the Waste bin. Nothing has been deleted." : {
      "comment" : "Quit warning text",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أنهيت الآن، فسينسى DiskGarden الملفات الموجودة في حاوية النفايات. لم يُحذف أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du jetzt beendest, vergisst DiskGarden die Dateien im Abfalleimer. Es wurde nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales ahora, DiskGarden olvidará los archivos de la Compostera. No se ha eliminado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez maintenant, DiskGarden oubliera les fichiers du bac à déchets. Rien n’a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esci ora, DiskGarden dimenticherà i file nel bidone. Non è stato eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま終了すると、DiskGarden は処分かごのファイルを忘れます。何も削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 종료하면 DiskGarden이 폐기함에 있는 파일을 잊어버립니다. 삭제된 항목은 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zakończysz teraz, DiskGarden zapomni pliki w Kompostowniku. Nic nie zostało usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você encerrar agora, o DiskGarden esquecerá os arquivos da Caçamba. Nada foi apagado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sair agora, o DiskGarden esquecerá os ficheiros do Compostor. Nada foi eliminado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если завершить работу сейчас, DiskGarden забудет файлы в мусорном баке. Ничего не было удалено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du avslutar nu glömmer DiskGarden filerna i komposten. Inget har raderats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi çıkarsanız DiskGarden, Kompost Kutusu'ndaki dosyaları unutur. Hiçbir şey silinmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вийти зараз, DiskGarden забуде файли в смітнику. Нічого не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn thoát bây giờ, DiskGarden sẽ quên các tệp trong Giỏ chờ xóa. Chưa có gì bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果现在退出，DiskGarden 将忘记清理篮中的文件。尚未删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果現在結束，DiskGarden 將忘記清理籃中的檔案。尚未刪除任何內容。"
          }
        }
      }
    },
    "DiskGarden is still deleting. Quitting now leaves the rest of the files in place." : {
      "comment" : "Quit warning text",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال DiskGarden يحذف الملفات. الخروج الآن يترك بقية الملفات كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden löscht noch. Wenn du jetzt beendest, bleiben die übrigen Dateien liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden sigue eliminando. Si sales ahora, el resto de los archivos se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden supprime encore. Quitter maintenant laisse les fichiers restants en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden sta ancora eliminando. Uscendo ora, i file restanti rimangono al loro posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
