    "DiskGarden" : {
      "comment" : "Email subject when sharing the app",
      "shouldTranslate" : false
    },
    "Full Disk Access is on.\nDiskGarden can see every folder on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول الكامل إلى القرص مُفعَّل.\nيستطيع DiskGarden رؤية كل مجلد على هذا الـ Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festplattenvollzugriff ist aktiv.\nDiskGarden sieht jeden Ordner auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso total al disco está activado.\nDiskGarden puede ver todas las carpetas de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès complet au disque est activé.\nDiskGarden voit tous les dossiers de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso completo al disco è attivo.\nDiskGarden può vedere ogni cartella di questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスクアクセスはオンです。\nDiskGarden はこの Mac のすべてのフォルダを見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한이 켜져 있습니다.\nDiskGarden이 이 Mac의 모든 폴더를 볼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełny dostęp do dysku jest włączony.\nDiskGarden widzi każdy folder na tym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Acesso Total ao Disco está ativado.\nO DiskGarden pode ver todas as pastas deste Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Acesso total ao disco está ativado.\nO DiskGarden pode ver todas as pastas deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ ко всему диску включён.\nDiskGarden видит все папки на этом Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hel skivåtkomst är på.\nDiskGarden ser alla mappar på den här Macen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Erişimi açık.\nDiskGarden bu Mac’teki her klasörü görebiliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повний доступ до диска увімкнено.\nDiskGarden бачить усі папки на цьому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập ổ đĩa đầy đủ đã bật.\nDiskGarden có thể thấy mọi thư mục trên máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全磁盘访问权限已开启。\nDiskGarden 可以看到这台 Mac 上的所有文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整磁碟取用權限已開啟。\nDiskGarden 可以看到這台 Mac 上的所有檔案夾。"
          }
        }
      }
    },
    "DiskGarden is currently scanning a disk. If you quit now, the scan will not be completed." : {
      "comment" : "Quit warning text",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم DiskGarden حاليًا بفحص قرص. إذا أنهيت الآن، فلن يكتمل الفحص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden scannt gerade ein Volume. Wenn du jetzt beendest, wird der Scan nicht abgeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden está analizando un disco. Si sales ahora, el análisis no se completará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden est en train d’analyser un disque. Si vous quittez maintenant, l’analyse ne sera pas terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden sta scansionando un disco. Se esci ora, la scansione non verrà completata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden はディスクをスキャン中です。いま終了すると、スキャンは完了しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden이 현재 디스크를 스캔하고 있습니다. 지금 종료하면 스캔이 완료되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden skanuje teraz dysk. Jeśli zakończysz teraz, skanowanie nie zostanie ukończone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DiskGarden está analisando um disco. Se você encerrar agora, a análise não será concluída."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DiskGarden está a analisar um disco. Se sair agora, a análise não será concluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden сейчас сканирует диск. Если завершить работу сейчас, сканирование не будет завершено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden skannar en skiva just nu. Om du avslutar nu slutförs inte skanningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden şu anda bir diski tarıyor. Şimdi çıkarsanız tarama tamamlanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden зараз сканує диск. Якщо вийти зараз, сканування не буде завершено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden đang quét một ổ đĩa. Nếu bạn thoát bây giờ, quá trình quét sẽ không hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden 正在扫描磁盘。如果现在退出，扫描将无法完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden 正在掃描磁碟。如果現在結束，掃描將無法完成。"
          }
        }
      }
    },
    "DiskGarden needs administrator access to scan all of “%@”." : {
      "comment" : "Shown in the macOS password prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DiskGarden إلى صلاحية المسؤول لفحص «%@» بالكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden benötigt Administratorzugriff, um „%@“ vollständig zu scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden necesita acceso de administrador para analizar todo “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden a besoin d’un accès administrateur pour analyser l’intégralité de « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden richiede l’accesso come amministratore per scansionare tutto «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」全体をスキャンするには、DiskGarden に管理者アクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 전체를 스캔하려면 DiskGarden에 관리자 접근 권한이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden potrzebuje dostępu administratora, aby przeskanować całość „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DiskGarden precisa de acesso de administrador para analisar todo o conteúdo de “%@”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DiskGarden precisa de acesso de administrador para analisar todo o conteúdo de “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden требуется доступ администратора, чтобы полностью отсканировать «%@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden behöver administratörsåtkomst för att skanna hela ”%@”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden'ın “%@” ögesinin tamamını taraması için yönetici erişimi gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden потребує доступу адміністратора, щоб повністю просканувати «%@»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden cần quyền truy cập của quản trị viên để quét toàn bộ “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden 需要管理员权限才能扫描“%@”的全部内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden 需要管理者權限才能掃描「%@」的全部內容。"
          }
        }
      }
    },
    "DiskGarden needs administrator access to scan folders it isn't allowed to read." : {
      "comment" : "Shown in the macOS password prompt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
