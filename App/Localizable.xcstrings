          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden이 아직 삭제 중입니다. 지금 종료하면 남은 파일은 그대로 남습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden nadal usuwa pliki. Zamknięcie teraz pozostawi resztę plików na miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DiskGarden ainda está excluindo. Sair agora deixa os arquivos restantes onde estão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
