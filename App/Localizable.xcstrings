    "Without Full Disk Access, macOS hides some folders from DiskGarden and their space shows up as “hidden space”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون الوصول الكامل إلى القرص، يُخفي macOS بعض المجلدات عن DiskGarden وتظهر مساحتها كـ «مساحة مخفية»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Festplattenvollzugriff verbirgt macOS einige Ordner vor DiskGarden und ihr Speicher wird als „verborgener Speicher“ angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Acceso total al disco, macOS oculta algunas carpetas a DiskGarden y su espacio aparece como “espacio oculto”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l’accès complet au disque, macOS masque certains dossiers à DiskGarden et leur espace apparaît comme « espace masqué »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza l’accesso completo al disco, macOS nasconde alcune cartelle a DiskGarden e il loro spazio viene mostrato come «spazio nascosto»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスクアクセスがないと、macOS は一部のフォルダを DiskGarden から隠すため、その領域は「隠れた領域」として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한이 없으면 macOS가 DiskGarden에서 일부 폴더를 숨기며, 해당 공간은 ‘숨겨진 공간’으로 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pełnego dostępu do dysku macOS ukrywa niektóre foldery przed DiskGarden, a zajmowane przez nie miejsce jest widoczne jako „ukryte miejsce”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o Acesso Total ao Disco, o macOS oculta algumas pastas do DiskGarden e o espaço delas aparece como “espaço oculto”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem Acesso total ao disco, o macOS oculta algumas pastas ao DiskGarden e o respetivo espaço aparece como “espaço oculto”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без доступа ко всему диску macOS скрывает от DiskGarden некоторые папки, и занятое ими место отображается как «скрытое пространство»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan Hel skivåtkomst döljer macOS vissa mappar för DiskGarden och deras utrymme visas som ”dolt utrymme”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Erişimi olmadan macOS bazı klasörleri DiskGarden'dan gizler ve bunların kapladığı alan “gizli alan” olarak görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без повного доступу до диска macOS приховує від DiskGarden деякі папки, і зайняте ними місце відображається як «приховане місце»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có quyền Truy cập ổ đĩa đầy đủ, macOS sẽ ẩn một số thư mục khỏi DiskGarden và dung lượng của chúng hiển thị dưới dạng “dung lượng ẩn”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若没有完全磁盘访问权限，macOS 会对 DiskGarden 隐藏某些文件夹，其空间会显示为“隐藏空间”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若沒有完整磁碟取用權限，macOS 會對 DiskGarden 隱藏某些資料夾，其空間會顯示為「隱藏空間」。"
          }
        }
      }
    },
