          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains dossiers n’ont pas été analysés car DiskGarden n’a pas un accès complet à votre disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune cartelle non sono state analizzate perché DiskGarden non ha accesso completo al disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
