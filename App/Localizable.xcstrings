        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі папки не проскановано, бо DiskGarden не має повного доступу до диска."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số thư mục chưa được quét vì DiskGarden không có quyền truy cập đầy đủ vào ổ đĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于 DiskGarden 没有磁盘的完全访问权限，部分文件夹未被扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
