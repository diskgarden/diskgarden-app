    "Live updates paused to save memory. Rescan to resume them." : {
      "comment" : "Notice when a long-running scan stops following file changes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف التحديثات المباشرة مؤقتًا لتوفير الذاكرة. أعد الفحص لاستئنافها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktualisierungen wurden pausiert, um Speicher zu sparen. Erneut scannen, um sie fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones en vivo se han pausado para ahorrar memoria. Vuelve a escanear para reanudarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour en direct sont suspendues pour économiser la mémoire. Relancez l’analyse pour les reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti in tempo reale sono in pausa per risparmiare memoria. Ripeti la scansione per riprenderli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリを節約するため、リアルタイム更新を一時停止しました。再スキャンすると再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리를 절약하기 위해 실시간 업데이트를 일시 정지했습니다. 다시 스캔하면 재개됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje na żywo wstrzymano, aby oszczędzić pamięć. Przeskanuj ponownie, aby je wznowić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações ao vivo foram pausadas para economizar memória. Escaneie novamente para retomá-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações em tempo real foram pausadas para poupar memória. Analise novamente para as retomar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления в реальном времени приостановлены для экономии памяти. Повторите сканирование, чтобы возобновить их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveuppdateringar har pausats för att spara minne. Skanna igen för att återuppta dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı güncellemeler bellek tasarrufu için duraklatıldı. Devam ettirmek için yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення в реальному часі призупинено, щоб заощадити пам’ять. Проскануйте знову, щоб відновити їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tạm dừng cập nhật trực tiếp để tiết kiệm bộ nhớ. Quét lại để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时更新已暂停以节省内存。重新扫描即可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時更新已暫停以節省記憶體。重新掃描即可恢復。"
          }
        }
      }
    },
