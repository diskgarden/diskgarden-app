          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden necesita acceso de administrador para analizar las carpetas que no tiene permiso para leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DiskGarden a besoin d’un accès administrateur pour analyser les dossiers qu’il n’est pas autorisé à lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
