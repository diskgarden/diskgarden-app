    "Nothing recovered yet. Put something big in the Waste bin and empty it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تتم استعادة أي مساحة بعد. ضع شيئًا كبيرًا في حاوية النفايات وأفرغها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts freigegeben. Lege etwas Großes in den Abfalleimer und leere ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has recuperado nada. Pon algo grande en la Compostera y vacíala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de récupéré pour l’instant. Placez quelque chose de volumineux dans le bac à déchets et videz-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nulla di recuperato. Metti qualcosa di grande nel bidone e svuotalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も回収していません。大きなものを処分かごに入れて空にしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 확보한 공간이 없습니다. 큰 항목을 폐기함에 넣고 비워 보십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nic nie odzyskano. Wrzuć coś dużego do Kompostownika i opróżnij go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada recuperado ainda. Coloque algo grande na Caçamba e esvazie-a."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não recuperou nada. Coloque algo grande no Compostor e esvazie-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не освобождено. Положите что-нибудь большое в мусорный бак и очистите его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget återvunnet än. Lägg något stort i komposten och töm den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz yer kazanılmadı. Kompost Kutusu'na büyük bir şey koyup boşaltın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки нічого не звільнено. Покладіть щось велике в смітник і очистіть його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa lấy lại được dung lượng nào. Hãy bỏ một thứ lớn vào Giỏ chờ xóa rồi dọn sạch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
