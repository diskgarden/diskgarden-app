    "1. Open Privacy & Security › Full Disk Access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. افتح «الخصوصية والأمن» › «الوصول الكامل إلى القرص»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne „Datenschutz & Sicherheit“ › „Festplattenvollzugriff“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Abre Privacidad y seguridad › Acceso total al disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ouvrez Confidentialité et sécurité › Accès complet au disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Apri Privacy e sicurezza › Accesso completo al disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「プライバシーとセキュリティ」›「フルディスクアクセス」を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 개인정보 보호 및 보안 › 전체 디스크 접근 권한을 여십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Otwórz Prywatność i ochrona › Pełny dostęp do dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Abra Privacidade e Segurança › Acesso Total ao Disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Abra Privacidade e segurança › Acesso total ao disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Откройте «Конфиденциальность и безопасность» › «Доступ ко всему диску»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öppna Integritet och säkerhet › Hel skivåtkomst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Gizlilik ve Güvenlik › Tam Disk Erişimi'ni açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Відкрийте «Приватність і безпека» › «Повний доступ до диска»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mở Quyền riêng tư & Bảo mật › Truy cập ổ đĩa đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开“隐私与安全性” › “完全磁盘访问权限”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打開「隱私權與安全性」›「完整磁碟取用權限」。"
          }
        }
      }
    },
    "2. Drag DiskGarden into the list (or click + and choose it)." : {
      "localizations" : {
        "ar" : {
