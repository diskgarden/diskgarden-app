          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기가 허용되지 않은 폴더를 스캔하려면 DiskGarden에 관리자 접근 권한이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
