            "value" : "Não foi possível abrir a análise guardada. Tente novamente ou volte a analisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть сохраненное сканирование. Повторите попытку или отсканируйте заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att öppna den sparade skanningen. Försök igen eller skanna om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen tarama açılamadı. Yeniden deneyin veya yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відкрити збережене сканування. Повторіть спробу або проскануйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể mở bản quét đã lưu. Hãy thử lại hoặc quét lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
