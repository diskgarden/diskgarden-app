    "Time Machine and system updates keep local APFS snapshots; files deleted since then still use space until macOS removes the snapshot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Time Machine وتحديثات النظام بلقطات APFS محلية؛ وتظل الملفات المحذوفة منذ ذلك الحين تشغل مساحة حتى يزيل macOS اللقطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine und Systemupdates behalten lokale APFS-Snapshots; seitdem gelöschte Dateien belegen weiterhin Speicher, bis macOS den Snapshot entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine y las actualizaciones del sistema conservan instantáneas APFS locales; los archivos eliminados desde entonces siguen ocupando espacio hasta que macOS elimina la instantánea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine et les mises à jour du système conservent des instantanés APFS locaux ; les fichiers supprimés depuis occupent encore de l’espace jusqu’à ce que macOS supprime l’instantané."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine e gli aggiornamenti di sistema conservano istantanee APFS locali; i file eliminati nel frattempo occupano ancora spazio finché macOS non rimuove l’istantanea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine とシステムアップデートはローカル APFS スナップショットを保持します。その後に削除したファイルも、macOS がスナップショットを削除するまで領域を使用し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine 및 시스템 업데이트는 로컬 APFS 스냅샷을 유지합니다. 그 이후 삭제된 파일은 macOS가 스냅샷을 제거할 때까지 계속 공간을 차지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine i uaktualnienia systemu przechowują lokalne migawki APFS; pliki usunięte od tamtej pory zajmują miejsce, dopóki macOS nie usunie migawki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Time Machine e as atualizações do sistema mantêm instantâneos APFS locais; os arquivos apagados desde então continuam ocupando espaço até o macOS remover o instantâneo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Time Machine e as atualizações do sistema mantêm instantâneos APFS locais; os ficheiros eliminados desde então continuam a ocupar espaço até o macOS remover o instantâneo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine и обновления системы хранят локальные снимки APFS; удаленные с тех пор файлы занимают место, пока macOS не удалит снимок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine och systemuppdateringar sparar lokala APFS-ögonblicksbilder. Filer som raderats sedan dess tar fortfarande plats tills macOS tar bort ögonblicksbilden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine ve sistem güncellemeleri yerel APFS anlık görüntüleri tutar; o zamandan beri silinen dosyalar, macOS anlık görüntüyü silene kadar yer kaplamaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine та оновлення системи зберігають локальні знімки APFS; видалені відтоді файли займають місце, доки macOS не видалить знімок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine và các bản cập nhật hệ thống giữ các bản chụp nhanh APFS cục bộ; các tệp đã xóa sau thời điểm đó vẫn chiếm dung lượng cho đến khi macOS xóa bản chụp nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间机器和系统更新会保留本地 APFS 快照；在此之后删除的文件仍会占用空间，直到 macOS 移除该快照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時光機和系統更新會保留本機 APFS 快照；在此之後刪除的檔案仍會佔用空間，直到 macOS 移除該快照。"
          }
        }
      }
    },
